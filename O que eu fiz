CREATE TABLE tabela_livros (

Id_livros INT auto_increment PRIMARY KEY,
Nome VARCHAR (400),
Lançamento INT,
Preço DECIMAL (10,2) 

);

CREATE TABLE tabela_filmes (

Id_filmes INT auto_increment PRIMARY KEY,
Nome VARCHAR (400),
Lançamento INT,
Preço DECIMAL (10,2),
Id_livros INT,
FOREIGN KEY (Id_livros) REFERENCES tabela_livros (Id_livros)

);

